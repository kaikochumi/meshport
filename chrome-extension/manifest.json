{
  "manifest_version": 3,
  "name": "Meshport",
  "version": "0.4.0",
  "description": "Export Tripo Studio models to STL, OBJ, glTF, GLB, FBX, or textures. The conversion runs entirely in your browser.",
  "homepage_url": "https://github.com/kaikochumi/meshport",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Meshport",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "*://tripo3d.ai/*",
    "*://*.tripo3d.ai/*",
    "*://tripo3d.com/*",
    "*://*.tripo3d.com/*",
    "*://meshy.ai/*",
    "*://*.meshy.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://tripo3d.ai/*",
        "*://*.tripo3d.ai/*"
      ],
      "js": [
        "main-world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://tripo3d.ai/*",
        "*://*.tripo3d.ai/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://meshy.ai/*",
        "*://*.meshy.ai/*"
      ],
      "js": [
        "meshy-world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://meshy.ai/*",
        "*://*.meshy.ai/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "sandbox": {
    "pages": [
      "sandbox.html"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'",
    "sandbox": "sandbox allow-scripts allow-downloads; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; child-src 'self'"
  }
}
