  "license": "MIT",
  "homepage": "https://github.com/kaikochumi/meshport#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaikochumi/meshport.git"
  },
  "scripts": {
    "build:vendor": "node tools/build-vendor.mjs",
    "make:fixture": "node tools/make-fixture.mjs",
    "test": "node --test"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
